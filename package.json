{
  "name": "space-arena-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm --workspace=client run dev",
    "dev:server": "npm --workspace=server run dev",
    "build": "npm --workspace=client run build",
    "start": "npm --workspace=server run start",
    "lint": "npx biome check --write client/src server/src scripts README.md"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}